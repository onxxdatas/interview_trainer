# Telegram
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token

# Restrict the bot to a single Telegram account (recommended for a personal bot).
# Leave empty to allow anyone who has the bot link.
ALLOWED_TELEGRAM_USER_ID=

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Database. SQLite by default; switch to a Postgres URL later without code changes:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/interview_trainer
DATABASE_URL=sqlite+aiosqlite:///./data/interview_trainer.db

# Default question interval in minutes for new users
DEFAULT_INTERVAL_MINUTES=15

# Logging
LOG_LEVEL=INFO
